# Talk-To-AI Environment Variables Template
#
# Note: the app doesn't read this file. Enter your API key, provider and model
# in the app under Settings → AI Model; they're saved to ~/.talktoai/settings.json.
# This template is kept for scripts or future use.

# Claude API Key (from https://console.anthropic.com)
CLAUDE_API_KEY=your-claude-api-key-here

# OpenAI API Key (from https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key (from https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# Default AI Provider (Claude, ChatGPT, or Gemini)
DEFAULT_AI_PROVIDER=Gemini

# Default Model
DEFAULT_MODEL=gemini-3.6-flash
